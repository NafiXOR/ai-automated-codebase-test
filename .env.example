# Copy this file to .env and adjust the values before starting n8n.
# cp .env.example .env
#
# There is no login setting here: n8n 1.0+ ignores the old N8N_BASIC_AUTH_* variables.
# On first visit to http://localhost:5678, n8n asks you to create an owner account instead.

# Host n8n reports itself as (used for building webhook URLs).
N8N_HOST=localhost

# Full base URL n8n uses when generating webhook URLs.
WEBHOOK_URL=http://localhost:5678/

# Timezone used for scheduling and timestamps inside workflows.
GENERIC_TIMEZONE=UTC
